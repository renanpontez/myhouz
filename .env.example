# ============================================================
# Supabase
# ============================================================
# Public - exposed to the browser via NEXT_PUBLIC_ prefix
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...local-anon-key...

# Private - server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...local-service-role-key...

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MyHouz"

# ============================================================
# Email (for invite notifications)
# ============================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# Feature Flags (optional)
# ============================================================
# NEXT_PUBLIC_ENABLE_BILLS=false
# NEXT_PUBLIC_ENABLE_SECRETS=false
